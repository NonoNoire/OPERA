{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opera.local/schemas/work.v1.schema.json",
  "title": "OPERA Studio Work v1",
  "type": "object",
  "required": [
    "schema_version",
    "entity_type",
    "id",
    "title",
    "created",
    "updated",
    "status",
    "source",
    "projects",
    "practice_domains",
    "medium",
    "related_entries",
    "related_experiments",
    "related_assets",
    "related_readings",
    "privacy",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "entity_type": {"const": "work"},
    "id": {
      "type": "string",
      "pattern": "^WORK-[0-9]{4}-[0-9]{4}$"
    },
    "title": {"type": "string", "minLength": 1},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "concept",
        "exploration",
        "prototyping",
        "in_progress",
        "paused",
        "resolved",
        "exhibited",
        "archived"
      ]
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["chatgpt-conversation", "manual", "import", "legacy-promotion"]
        },
        "agent": {"type": ["string", "null"]},
        "captured_by": {"type": ["string", "null"]},
        "source_note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "practice_domains": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "medium": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "related_entries": {
      "type": "array",
      "items": {"type": "string", "pattern": "^OPERA-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "related_experiments": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "related_assets": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ASSET|BATCH)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "related_readings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "privacy": {
      "type": "object",
      "required": [
        "contains_personal_data",
        "contains_identifiable_images",
        "contains_body_derived_data",
        "contains_third_party_material",
        "research_export_default"
      ],
      "properties": {
        "contains_personal_data": {"type": "boolean"},
        "contains_identifiable_images": {"type": "boolean"},
        "contains_body_derived_data": {"type": "boolean"},
        "contains_third_party_material": {"type": "boolean"},
        "research_export_default": {
          "type": "string",
          "enum": ["include", "filtered", "exclude"]
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": [
        "Proposition",
        "Current form",
        "Genealogy",
        "Materials and processes",
        "Theoretical relations",
        "Decisions",
        "Open questions",
        "Next experiment",
        "Revision history"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
