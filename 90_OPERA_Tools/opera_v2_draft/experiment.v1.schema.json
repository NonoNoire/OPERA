{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opera.local/schemas/experiment.v1.schema.json",
  "title": "OPERA Studio Experiment v1",
  "type": "object",
  "required": [
    "schema_version",
    "entity_type",
    "id",
    "date",
    "experiment_type",
    "status",
    "source",
    "work_ids",
    "scan_mode",
    "assets_used",
    "assets_produced",
    "equipment",
    "conditions",
    "privacy",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "entity_type": {"const": "experiment"},
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "date": {"type": "string", "format": "date"},
    "experiment_type": {
      "type": "string",
      "enum": [
        "3d_scan",
        "3d_modelling",
        "3d_print",
        "drawing",
        "painting",
        "sculpture",
        "installation",
        "material_test",
        "wearability_test",
        "photography",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "completed", "aborted", "validated", "archived"]
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["chatgpt-conversation", "manual", "import", "legacy-promotion"]
        },
        "agent": {"type": ["string", "null"]},
        "captured_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "work_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^WORK-[0-9]{4}-[0-9]{4}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "scan_mode": {
      "type": "string",
      "enum": ["not_applicable", "instrumental", "expressive", "hybrid"]
    },
    "assets_used": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ASSET|BATCH)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "assets_produced": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ASSET|BATCH)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "equipment": {
      "type": "object",
      "required": ["primary_tool"],
      "properties": {
        "primary_tool": {"type": ["string", "null"]},
        "software": {"type": ["string", "null"]},
        "software_version": {"type": ["string", "null"]},
        "calibration": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "required": ["setting"],
      "properties": {
        "setting": {"type": ["string", "null"]},
        "lighting": {"type": ["string", "null"]},
        "background": {"type": ["string", "null"]},
        "movement": {"type": ["string", "null"]},
        "distance": {"type": ["string", "null"]},
        "passes": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "contains_personal_data",
        "contains_identifiable_images",
        "contains_body_derived_data",
        "contains_third_party_material",
        "research_export_default"
      ],
      "properties": {
        "contains_personal_data": {"type": "boolean"},
        "contains_identifiable_images": {"type": "boolean"},
        "contains_body_derived_data": {"type": "boolean"},
        "contains_third_party_material": {"type": "boolean"},
        "research_export_default": {
          "type": "string",
          "enum": ["include", "filtered", "exclude"]
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": [
        "Intent and research question",
        "Planned procedure",
        "Actual procedure",
        "Deviations",
        "Observations",
        "Technical events and anomalies",
        "Artistic selection",
        "Technical evaluation",
        "Perceptual evaluation",
        "Interpretation",
        "Next iteration"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
