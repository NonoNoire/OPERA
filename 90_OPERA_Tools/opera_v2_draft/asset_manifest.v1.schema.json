{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opera.local/schemas/asset_manifest.v1.schema.json",
  "title": "OPERA Studio Asset Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "entity_type",
    "id",
    "date",
    "manifest_kind",
    "status",
    "source",
    "work_ids",
    "experiment_ids",
    "asset_role",
    "media_type",
    "storage",
    "file_globs",
    "derives_from",
    "privacy",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "entity_type": {"const": "asset"},
    "id": {
      "type": "string",
      "pattern": "^(ASSET|BATCH)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "date": {"type": "string", "format": "date"},
    "manifest_kind": {
      "type": "string",
      "enum": ["individual", "batch"]
    },
    "status": {
      "type": "string",
      "enum": ["declared", "indexed", "selected", "superseded", "missing", "archived"]
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["chatgpt-conversation", "manual", "filesystem-index", "import", "legacy-promotion"]
        },
        "agent": {"type": ["string", "null"]},
        "captured_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "work_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^WORK-[0-9]{4}-[0-9]{4}$"},
      "uniqueItems": true
    },
    "experiment_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "asset_role": {
      "type": "string",
      "enum": [
        "raw_capture",
        "reference",
        "documentation",
        "working_file",
        "selected_fragment",
        "processed_output",
        "fabrication_file",
        "physical_output_documentation",
        "publication_output",
        "other"
      ]
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "drawing",
        "3d_scan",
        "mesh",
        "texture",
        "cad",
        "gcode",
        "video",
        "audio",
        "document",
        "mixed",
        "physical_object_record",
        "other"
      ]
    },
    "storage": {
      "type": "object",
      "required": ["tier", "root_path", "path_kind", "verify_exists"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["vault", "local_archive", "external_drive", "cloud_archive"]
        },
        "root_path": {"type": "string", "minLength": 1},
        "path_kind": {
          "type": "string",
          "enum": ["file", "directory"]
        },
        "verify_exists": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "file_globs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "derives_from": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(ASSET|BATCH)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
      "uniqueItems": true
    },
    "privacy": {
      "type": "object",
      "required": [
        "contains_personal_data",
        "contains_identifiable_images",
        "contains_body_derived_data",
        "contains_third_party_material",
        "contains_sensitive_local_path",
        "research_export_default"
      ],
      "properties": {
        "contains_personal_data": {"type": "boolean"},
        "contains_identifiable_images": {"type": "boolean"},
        "contains_body_derived_data": {"type": "boolean"},
        "contains_third_party_material": {"type": "boolean"},
        "contains_sensitive_local_path": {"type": "boolean"},
        "research_export_default": {
          "type": "string",
          "enum": ["include", "filtered", "exclude"]
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": [
        "Description",
        "Selection rationale",
        "Transformations",
        "Technical notes",
        "Rights and restrictions",
        "Preservation notes"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
